# Copy this file to /etc/happyclass-monitor.env on the VPS.
# Keep the real file chmod 600 because it contains the Gmail app password.

BACKEND_PM2_NAME=nest-backend
TTS_PM2_NAME=my-flask-app
PM2_BIN=/usr/local/bin/pm2

BACKEND_ROOT_URL=https://api.happyclass.com.vn/
BACKEND_ROOT_EXPECTED_TEXT=
BACKEND_TTS_HEALTH_URL=https://api.happyclass.com.vn/homeworks/textToSpeech/health
BACKEND_TTS_HEALTH_EXPECTED_TEXT=ok
DIRECT_TTS_VOICES_URL=http://127.0.0.1:5000/voices
DIRECT_TTS_EXPECTED_TEXT=voices

RESTART_THRESHOLD=3
RESTART_WINDOW_SECONDS=300
PROCESS_DOWN_SECONDS=60
ENDPOINT_FAIL_SECONDS=60
ENDPOINT_FAIL_COUNT=3
MEMORY_THRESHOLD_PERCENT=70
ALERT_COOLDOWN_SECONDS=900

COMMAND_TIMEOUT_SECONDS=10
HTTP_TIMEOUT_SECONDS=10
LOG_LINES=80
STATE_FILE=/var/tmp/happyclass-health-state.json

SECURITY_CHECK_ENABLED=true
AUTH_LOG_PATHS=/var/log/auth.log,/var/log/secure
SECURITY_FAILED_SSH_THRESHOLD=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=xpoutsource@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
ALERT_EMAIL_FROM=xpoutsource@gmail.com
ALERT_EMAIL_TO=xpoutsource@gmail.com
